{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Greenroom Local",
  "version": "0.1.0",
  "identifier": "app.greenroom.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Greenroom Local",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#0C100E",
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "media-src": "'self' blob: data: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGN0RGOUQwQjM4M0I1QUEKUldTcXRZT3owUGw5enluUXo2ZG1wOEF3RGVqVlVZcVpUQjgzSzZQL2FXT212OEdKLytiTHVWSFgK",
      "endpoints": [
        "https://github.com/Olusegune/Greenroom_Local/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
